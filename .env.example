# Required
MISTRAL_API_KEY=your-key-here

# Optional (defaults shown)
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
# STT_MODEL=voxtral-mini-transcribe-realtime-2602
# STT_DELAY_MS=480
# BATCH_STT_MODEL=voxtral-mini-latest
# LLM_MODEL=mistral-large-latest
# TTS_MODEL=voxtral-mini-tts-latest
# AGENT_PERSONA=Asha                      # name of the AI assistant
# AGENT_VOICE=gb_jane_neutral              # Voxtral voice of the AI assistant (old name: TTS_VOICE)
# SPECIALIST_NAME=Oliver                   # name of the simulated human fraud specialist
# SPECIALIST_VOICE=gb_oliver_confident     # Voxtral voice of the specialist
# BANK_NAME=Northbridge Bank
# TURN_DETECTION=local                     # local | vad (lightest CPU) | stt
# STT_STALL_SECONDS=5                      # reconnect Voxtral if this much speech gets no reply
# SUMMARY_MODEL=mistral-large-latest
# JURISDICTION=IN_RBI        # IN_RBI | US_REG_E | UK_PSR
# RING_SECONDS=5
# AMBIENT_SOUND=off
# RECORD_CALLS=on
