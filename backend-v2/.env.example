# Backend v2 reads backend-v2/.env first, then the project's .env (so the same key works for both backends).
MISTRAL_API_KEY=your-key-here

# ── Managed voice session (client.audio.sessions.init). STT/TTS empty = Mistral's defaults. ──
# VOICE_LLM_MODEL=mistral-large-latest              # default (same brain as v1)
# VOICE_STT_MODEL=voxtral-mini-transcribe-realtime-3
# VOICE_TTS_MODEL=voxtral-mini-tts-3
AGENT_VOICE=gb_jane_neutral

# ── Direct API calls ──
# STT_MODEL=voxtral-mini-transcribe-realtime-2602   # specialist interview channels
# BATCH_STT_MODEL=voxtral-mini-latest               # diarised transcript for the investigation brief
# TTS_MODEL=voxtral-mini-tts-latest                 # simulated specialist's voice
# LLM_MODEL=mistral-large-latest                    # simulated specialist's brain
# SUMMARY_MODEL=mistral-large-latest
SPECIALIST_VOICE=gb_oliver_confident

# ── App ──
# BANK_NAME=Northbridge Bank
# AGENT_PERSONA=Asha
# SPECIALIST_NAME=Oliver
# JURISDICTION=IN_RBI
# RING_SECONDS=5
# SILENCE_CHECK_SECONDS=10
# RECORD_CALLS=on

# ── Local LiveKit server (the browser's phone line), `livekit-server --dev` defaults ──
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
